# Editor style guide.
#   - LF line endings, UTF-8, final newline at EOF, no trailing whitespace.
#   - Source (JS) indented with TABs — this matches src/*.js.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.js]
indent_style = tab
indent_size = tab

[*.json]
indent_style = space
indent_size = 2
